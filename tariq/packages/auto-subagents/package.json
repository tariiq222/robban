{
  "name": "dsh-auto-subagents",
  "version": "0.4.0-dev.0",
  "private": true,
  "description": "Auto Subagents mode for DSH: tier routing with provider fallback, read-only coordinator, saved workflow recipes (run_recipe), and the in-chat run card.",
  "type": "module",
  "main": "./lib/index.js",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./router": "./lib/router.mjs",
    "./runtime": "./lib/runtime.mjs",
    "./coordinator": "./lib/coordinator.mjs",
    "./recipes": "./lib/recipes.mjs",
    "./events": "./lib/events.mjs",
    "./dsh-paths": "./lib/dsh-paths.mjs",
    "./recipe-integrity": "./lib/recipe-integrity.mjs",
    "./package.json": "./package.json",
    "./delegation": "./lib/delegation.mjs",
    "./model-selection": "./lib/model-selection.mjs",
    "./settings-migration": "./lib/settings-migration.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./preset.patch.yml": "./preset.patch.yml"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs test/legacy/*.test.mjs"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@deepseek-ai/dsh-agent-loop": "workspace:*",
    "@deepseek-ai/dsh-session-persistence": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tool-subagent": "workspace:*",
    "@deepseek-ai/dsh-workflow-ptc": "workspace:*",
    "@deepseek-ai/dsh-sandbox-policy": "workspace:*",
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-fs-local": "workspace:*",
    "@deepseek-ai/dsh-subprocess-local": "workspace:*",
    "@deepseek-ai/dsh-sandbox-local": "workspace:*",
    "@deepseek-ai/dsh-ptc-runtime-node": "workspace:*",
    "@deepseek-ai/dsh-subagent": "workspace:*",
    "js-yaml": "^4.1.0",
    "@deepseek-ai/dsh-web-app": "workspace:*"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    },
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./preset.patch.yml"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "build.mjs",
    "core-patches",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "preset.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-subagent": "workspace:*",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "workspace:*",
    "@deepseek-ai/dsh-scope": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-preset": "workspace:*",
    "@deepseek-ai/dsh-persona": "workspace:*",
    "@deepseek-ai/dsh-agent-instructions": "workspace:*",
    "@deepseek-ai/dsh-tool-bash": "workspace:*",
    "@deepseek-ai/dsh-tool-pwsh": "workspace:*",
    "@deepseek-ai/dsh-tool-fs": "workspace:*",
    "@deepseek-ai/dsh-tool-fs-search": "workspace:*",
    "@deepseek-ai/dsh-tool-jobs": "workspace:*",
    "@deepseek-ai/dsh-skill-filesystem": "workspace:*",
    "@deepseek-ai/dsh-tool-skill": "workspace:*",
    "@deepseek-ai/dsh-command-goal": "workspace:*",
    "@deepseek-ai/dsh-tool-goal": "workspace:*",
    "@deepseek-ai/dsh-plan-mode": "workspace:*",
    "@deepseek-ai/dsh-compaction-basic": "workspace:*",
    "@deepseek-ai/dsh-command-compact": "workspace:*",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "workspace:*",
    "@deepseek-ai/dsh-tool-subagent-control": "workspace:*",
    "@deepseek-ai/dsh-tool-subagent": "workspace:*",
    "@deepseek-ai/dsh-workflow-ptc": "workspace:*",
    "@deepseek-ai/dsh-tool-workflow": "workspace:*",
    "@deepseek-ai/dsh-tool-ralph": "workspace:*",
    "@deepseek-ai/dsh-tool-ask-user": "workspace:*",
    "@deepseek-ai/dsh-tool-todo": "workspace:*",
    "@deepseek-ai/dsh-tool-web": "workspace:*",
    "@deepseek-ai/dsh-tool-present": "workspace:*",
    "@deepseek-ai/dsh-plugin-manager": "workspace:*"
  }
}
